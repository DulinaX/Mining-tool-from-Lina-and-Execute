<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Pakete kommen aus vendor/nuget (offline), falls der Ordner da ist – sonst von nuget.org. -->
  <packageSources>
    <clear/>
    <add key="vendored-offline" value="vendor/nuget"/>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json"/>
  </packageSources>
  <config><add key="globalPackagesFolder" value="work/packages"/></config>
</configuration>
