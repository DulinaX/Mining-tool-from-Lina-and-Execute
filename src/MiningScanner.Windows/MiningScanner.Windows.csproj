<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MiningTool</AssemblyName>
    <RootNamespace>MiningScanner.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.1.0</Version>
    <Company>DulinaX &amp; Execute</Company>
    <Product>Mining Tool</Product>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Copyright>© 2026 DulinaX &amp; Execute</Copyright>
    <Authors>DulinaX &amp; Execute</Authors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../MiningScanner.Core/MiningScanner.Core.csproj"/>
    <PackageReference Include="Tesseract" Version="5.2.0"/>
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2"/>
    <Content Include="../../resources/tessdata/eng.traineddata" Link="tessdata/eng.traineddata" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="../../data/signatures.json" Link="data/signatures.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
    <Content Include="../../resources/native/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/>
  </ItemGroup>
  <Target Name="ExcludeUnusedRuntimeHelpers" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Filename)%(ResolvedFileToPublish.Extension)' == 'createdump.exe'" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').StartsWith('x86'))" />
    </ItemGroup>
  </Target>
</Project>
